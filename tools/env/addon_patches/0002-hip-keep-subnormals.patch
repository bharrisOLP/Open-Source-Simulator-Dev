+def _wrap_hip_cache_key_entry_point(original: Callable, state: Dict[str, Any]) -> Optional[Callable]:
+    """The ROCm form of :func:`_wrap_cache_key_entry_point` (``_compile_with_cache_hip``).
+
+    The same token, folded into ``extra_source``, which a ROCm CuPy also hashes
+    into its key (``key_src = env, base, source, extra_source``). From ROCm 4.4
+    on, ``_convert_to_hip_source`` returns the source unchanged and reads no
+    ``extra_source``, so the token changes the key and not the binary.
+
+    THE TOKEN IS THE ONLY BARRIER on CuPy 14: its disk cache back end reads
+    ``CUPY_CACHE_DIR`` once, when ``cupy.cuda.compiler`` is imported, so the
+    policy-suffixed directory that :func:`point_cupy_cache_at_keep_policy` names
+    later is not the directory that CuPy writes. Without the token, a keep
+    compile would read back a binary that a flush compile wrote under the same key.
+
+    The parameter is found BY NAME (``inspect.signature``, which follows the
+    ``__wrapped__`` of a wrapper that ``functools.wraps`` made). Returns ``None``
+    when the function has no ``extra_source`` parameter; the caller then records
+    that the token could not be folded in.
+    """
+    try:
+        signature = inspect.signature(original)
+    except (TypeError, ValueError):
+        return None
+    if "extra_source" not in signature.parameters:
+        return None
+
+    @functools.wraps(original)
+    def keyed(*args, **kwargs):
+        state["keyed"] = state.get("keyed", 0) + 1
+        bound = signature.bind(*args, **kwargs)
+        extra_source = bound.arguments.get("extra_source")
+        bound.arguments["extra_source"] = (CUPY_KEEP_CACHE_KEY_TOKEN if extra_source is None
+                                           else f"{extra_source}\n{CUPY_KEEP_CACHE_KEY_TOKEN}")
+        return original(*bound.args, **bound.kwargs)
+
+    setattr(keyed, _POLICY_MARK, KEEP)
+    return keyed
+
+
