+#: The ROCm subtraction of :func:`_subtract_once`, one elementwise kernel, built at its first use.
+_HIP_NAN_ORDERED_SUBTRACT: Any = None
+
+
+def nan_ordered_subtract(minuend: Any, subtrahend: Any) -> Any:
+    """``minuend -= subtrahend`` in place for the source deposit, with the NaN word of the host's subtraction.
+
+    ``sources._deposit`` forms ``real(A) = amp_re * c_re - amp_im * c_im`` before the door, on the device when the
+    fields are on the device; this is that subtraction (:func:`_subtract_once`). Returns the result, which is
+    ``minuend`` itself for an array.
+    """
+    return _subtract_once(index_module(minuend), minuend, subtrahend)
+
+
+def _subtract_once(xp: Any, wide: Any, subtrahend: Any) -> Any:
+    """``wide - subtrahend`` in float64, in place, one rounding, with the NaN word of the host's subtraction.
+
+    IEEE 754 leaves the sign of a NaN result open. On a ROCm build of CuPy the GPU forms ``a - b`` as
+    ``a + (-b)``, so a NaN ``b`` comes back with its sign bit inverted (measured on an AMD Radeon RX 7900 XT,
+    gfx1100: ``1.5 - b`` for four NaN words of both signs); NumPy on an x86 host returns ``b`` itself. A deposit
+    of a NaN ``real(A)`` (an infinite amplitude and a zero current) therefore stored ``0x7fc00000`` on that GPU
+    and ``0xffc00000`` on the host. On a ROCm build one elementwise kernel takes a NaN operand as it is, in the
+    host's order (a NaN ``wide`` first, then a NaN ``subtrahend``) and forms every other word by the one
+    subtraction, so the deposit launches as many kernels as before. A subtrahend array of another dtype is widened
+    to float64 first, as the in-place subtraction widens it. A signalling NaN comes back as it is, where x86 sets
+    its quiet bit; the rounding to float32 in the door quiets it on both sides. Every other build, and a
+    ``wide`` that is not a float64 array, keeps the in-place subtraction unchanged.
+    """
+    global _HIP_NAN_ORDERED_SUBTRACT
+    runtime = getattr(getattr(xp, "cuda", None), "runtime", None)
+    if not getattr(runtime, "is_hip", False) or getattr(wide, "dtype", None) != xp.float64:
+        wide -= subtrahend
+        return wide
+    if getattr(subtrahend, "dtype", xp.float64) != xp.float64:
+        subtrahend = subtrahend.astype(xp.float64, copy=False)
+    if _HIP_NAN_ORDERED_SUBTRACT is None:
+        _HIP_NAN_ORDERED_SUBTRACT = xp.ElementwiseKernel(
+            "float64 a, float64 b", "float64 out", "out = isnan(a) ? a : (isnan(b) ? b : a - b)",
+            "meep_gpu_hip_nan_ordered_subtract")
+    return _HIP_NAN_ORDERED_SUBTRACT(wide, subtrahend, wide)
+
+
